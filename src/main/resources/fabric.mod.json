{
	"schemaVersion": 1,
	"id": "chestmemory",
	"version": "${version}",
	"name": "Chest Memory",
	"description": "Remembers chest contents per world/server, search with the grave key (Ё on a Russian layout), highlights containers. Works on Fabric 26.1.2 and 26.2.",
	"authors": [
		"Karandash"
	],
	"contact": {
		"homepage": "https://github.com/1harios/chestmemory",
		"sources": "https://github.com/1harios/chestmemory",
		"issues": "https://github.com/1harios/chestmemory/issues"
	},
	"license": "MIT",
	"icon": "assets/chestmemory/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.chestmemory.ChestMemoryMod"
		],
		"client": [
			"com.chestmemory.client.ChestMemoryClient"
		],
		"jade": [
			"com.chestmemory.client.jade.ChestMemoryJadePlugin"
		]
	},
	"mixins": [
		{
			"config": "chestmemory.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": [
			"~26.1.2",
			"~26.2"
		],
		"java": ">=25",
		"fabric-api": ">=0.155.2"
	},
	"suggests": {
		"jade": "*",
		"litematica": "*"
	}
}
